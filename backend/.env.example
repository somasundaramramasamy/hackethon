# Copy to .env and fill in. .env is git-ignored: never commit it.

# Shared team database: TiDB Cloud Starter (MySQL-compatible). Ask a teammate for the host, user and password.
# Keep sslMode=VERIFY_IDENTITY (TiDB requires TLS) and tinyInt1isBit=false on the URL.
DB_URL=jdbc:mysql://HOST:4000/cognizant?createDatabaseIfNotExist=true&sslMode=VERIFY_IDENTITY&tinyInt1isBit=false
DB_USERNAME=
DB_PASSWORD=

# Models: any OpenAI-compatible endpoint. OpenRouter by default (https://openrouter.ai/keys);
# set a credit limit on the key. One key covers the assistant under test, the judge and the agents.
OPENROUTER_API_KEY=

# Optional: a different endpoint, e.g. your own vLLM or Ollama server (http://localhost:11434/v1).
# LLM_BASE_URL=
# LLM_API_KEY=
# Optional: a separate endpoint for the judge and agents, e.g. a self-hosted judge.
# JUDGE_BASE_URL=
# JUDGE_API_KEY=

# Optional: true for a public, read-only demo.
# KAVASAM_READ_ONLY=false
# ALLOWED_ORIGINS=http://localhost:5173
