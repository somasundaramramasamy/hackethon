# Copy to .env and fill in. .env is git-ignored: never commit it.

# Shared team database: TiDB Cloud Starter (MySQL-compatible). Ask a teammate for the host, user and password.
# Keep sslMode=VERIFY_IDENTITY (TiDB requires TLS) and tinyInt1isBit=false on the URL.
DB_URL=jdbc:mysql://HOST:4000/cognizant?createDatabaseIfNotExist=true&sslMode=VERIFY_IDENTITY&tinyInt1isBit=false
DB_USERNAME=
DB_PASSWORD=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
